from time_series_models.layers.Embed import DataEmbedding_inverted, PositionalEmbedding


class Configs:
    def __init__(self, config=None):
        # 如果传入了config对象（来自训练脚本），使用其参数
        if config is not None:
            self.seq_len = getattr(config, 'seq_len', 365)
            self.pred_len = getattr(config, 'pred_len', 7)
            self.d_model = getattr(config, 'd_model', 256)
            self.hidden_size = getattr(config, 'hidden_size', 128)
            self.num_layers = getattr(config, 'num_layers', 2)
            self.dropout = getattr(config, 'dropout', 0.1)
            self.activation = getattr(config, 'activation', 'relu')
            self.bidirectional = getattr(config, 'bidirectional', True)
            self.output_attention = getattr(config, 'output_attention', False)
            self.use_norm = getattr(config, 'use_norm', True)
            self.embed = getattr(config, 'embed', 'timeF')
            self.freq = getattr(config, 'freq', 'd')
        else:
            # 硬编码的参数，专门用于时间序列预测
            self.seq_len = 365  # 输入序列长度
            self.pred_len = 7   # 预测长度
            self.d_model = 256  # 模型维度
            self.hidden_size = 128  # LSTM隐藏层大小
            self.num_layers = 2  # LSTM层数
            
            # 模型结构参数
            self.dropout = 0.1  # Dropout率
            self.activation = 'relu'  # 激活函数
            self.bidirectional = True  # 使用双向LSTM
            
            # 其他参数
            self.output_attention = False  # 是否输出注意力权重
            self.use_norm = True  # 是否使用归一化
            self.embed = 'timeF'  # 嵌入类型
            self.freq = 'd'  # 频率


class LSTMEmbedding(nn.Module):
    def __init__(self, d_model, dropout, seq_len=365):
        super(LSTMEmbedding, self).__init__()
        # Value embedding
        self.value_embedding = nn.Linear(seq_len, 365, bias=False)
        
        # Global token
        self.glb_token = nn.Parameter(torch.randn(1, 1, 365))
        self.position_embedding = PositionalEmbedding(365)
        
        self.dropout = nn.Dropout(dropout)

    def forward(self, x):
        # x: [B, N, L] -> [B, N, d_model]
        n_vars = x.shape[1]
        glb = self.glb_token.repeat((x.shape[0], 1, 1))
        
        x = self.value_embedding(x) + self.position_embedding(x)
        
        # Add global token
        x = torch.cat([x, glb], dim=1)
        
        return self.dropout(x), n_vars


class AttentionLSTM(nn.Module):
    """
    LSTM with attention mechanism for time series forecasting
    """
    def __init__(self, input_size, hidden_size, num_layers=2, dropout=0.1, 
                 bidirectional=False, attention=True):
        super(AttentionLSTM, self).__init__()
        self.hidden_size = hidden_size
        self.num_layers = num_layers
        self.bidirectional = bidirectional
        self.attention = attention
        
        # LSTM layers
        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=num_layers,
            dropout=dropout if num_layers > 1 else 0,
            bidirectional=bidirectional,
            batch_first=True
        )
        
        # Attention mechanism
        if attention:
            self.attention_layer = nn.MultiheadAttention(
                embed_dim=hidden_size * (2 if bidirectional else 1),
                num_heads=8,
                dropout=dropout,
                batch_first=True
            )
        
        # Layer normalization
        self.layer_norm = nn.LayerNorm(hidden_size * (2 if bidirectional else 1))
        
        # Dropout
        self.dropout = nn.Dropout(dropout)

    def forward(self, x):
        """
        x: [B, L, D] where L is sequence length, D is feature dimension
        """
        # LSTM forward pass
        lstm_out, (hidden, cell) = self.lstm(x)
        
        # Apply attention if enabled
        if self.attention:
            # Self-attention on LSTM output
            attn_out, _ = self.attention_layer(lstm_out, lstm_out, lstm_out)
            # Residual connection
            lstm_out = lstm_out + attn_out
        
        # Layer normalization and dropout
        lstm_out = self.layer_norm(lstm_out)
        lstm_out = self.dropout(lstm_out)
        
        return lstm_out, (hidden, cell)

class Model(nn.Module):
    """
    基于LSTM的时间序列预测模型
    参考s_mamba_enex.py的输入输出结构
    """

    def __init__(self, configs):
        super(Model, self).__init__()
        
        # 如果传入的是训练脚本的Config对象，需要转换为我们的Configs对象
        if hasattr(configs, 'model_name'):  # 这是训练脚本的Config对象
            # 创建我们的Configs对象，传入训练脚本的config
            configs = Configs(configs)
        
        self.seq_len = configs.seq_len
        self.pred_len = configs.pred_len
        self.output_attention = configs.output_attention
        self.use_norm = configs.use_norm

        # 使用DataEmbedding_inverted进行时间编码
        self.enc_embedding = DataEmbedding_inverted(
            configs.seq_len, configs.d_model, configs.embed, configs.freq,
            configs.dropout, time_feat_dim=8
        )

        # LSTM layers
        self.lstm_layers = AttentionLSTM(
            input_size=configs.d_model,
            hidden_size=configs.hidden_size,
            num_layers=configs.num_layers,
            dropout=configs.dropout,
            bidirectional=configs.bidirectional,
            attention=True
        )

        # Output projection
        lstm_output_size = configs.hidden_size * (2 if configs.bidirectional else 1)
        # self.projector = nn.Linear(lstm_output_size, configs.pred_len, bias=True)
        self.projector = nn.Sequential(
            nn.Linear(lstm_output_size, configs.d_model),
            nn.BatchNorm1d(configs.d_model),
            nn.GELU(),
            nn.Dropout(configs.dropout),
            nn.Linear(configs.d_model, configs.pred_len),
            )
        # Optional: Additional processing layers
        self.output_norm = nn.LayerNorm(lstm_output_size) if configs.use_norm else None

    def forecast(self, x_enc, x_mark_enc):
        """
        x_enc: [B, L, N] -> input sequence
        x_mark_enc: [B, L, time_features]
        """
        B, T, C, H, W = x_enc.shape
        x_enc = x_enc[:, :, :, H//2, W//2].squeeze() # B L N
        
        # Apply frequency MoE if enabled
        # if hasattr(self, 'sel_freq_moe'):
        #     x_enc = self.sel_freq_moe(x_enc)
        
        # Handle missing values
        x_enc = torch.where(x_enc == -9999, torch.full_like(x_enc, 0.5), x_enc)
        
        # Apply Gaussian diffusion to first variable (FIRMS data)
        # x_before_gaussian = x_enc.clone()
        # x_firms = x_enc[:, :, 0]  # [B, L]
        # x_firms_diffused = self._gaussian_diffuse_1d(x_firms, sigma=7.0)
        # x_enc[:, :, 0] = x_firms_diffused
        
        # 使用DataEmbedding_inverted进行时间编码
        enc_out = self.enc_embedding(x_enc, x_mark_enc)  # [B, N, D]
        
        # LSTM处理
        lstm_out, (hidden, cell) = self.lstm_layers(enc_out)  # [B, N, hidden_size]
        
        # Apply normalization before projection if enabled
        # if self.output_norm is not None:
        #     lstm_out = self.output_norm(lstm_out)
        
        # Project to prediction length
        dec_out = self.projector(lstm_out[:, 0, :])# .permute(0, 2, 1)  # [B, pred_len, N]
        
        return dec_out

    def forward(self, x_enc, x_mark_enc, x_dec, x_mark_dec, burn_history=None):
        dec_out = self.forecast(x_enc, x_mark_enc)
        return dec_out# [:, -self.pred_len:, :][:, :, 0]  # [B, L, N]

if __name__ == '__main__':
    # Test configuration - 使用硬编码参数
    configs = Configs()
    
    # Create model and move to GPU
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = Model(configs).to(device)
    
    # Test data
    batch_size = 32
    x_enc = torch.randn(batch_size, configs.seq_len, 40).to(device)  # [32, 365, 40]
    x_mark_enc = torch.randn(batch_size, configs.seq_len, 7).to(device)  # Time features
    x_dec = torch.randn(batch_size, configs.pred_len, configs.d_model).to(device)  # Decoder input
    x_mark_dec = torch.randn(batch_size, configs.pred_len, 7).to(device)  # Decoder time features
    
    # Forward propagation test
    output = model(x_enc, x_mark_enc, x_dec, x_mark_dec)
    print(f"Input shape: {x_enc.shape}")
    print(f"Output shape: {output.shape}")
    print(f"Model parameters: {sum(p.numel() for p in model.parameters()):,}")
    
    # Test forecast method directly
    forecast_output = model.forecast(x_enc, x_mark_enc)
    print(f"Forecast output shape: {forecast_output.shape}")
